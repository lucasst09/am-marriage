# Multi-stage build para produção
# Stage 1: Build da aplicação
FROM node:latest AS builder

WORKDIR /app

# Copiar arquivos de dependências
COPY package*.json ./

# Instalar todas as dependências (incluindo dev para build)
RUN npm install

# Copiar código fonte
COPY . .

# Build da aplicação para produção
RUN npm run build

# Stage 2: Produção com nginx + Express
FROM nginx:alpine

# Instalar Node.js no container nginx
RUN apk add --no-cache nodejs npm

WORKDIR /app

# Copiar apenas package.json e package-lock.json
COPY package*.json ./

# Instalar apenas dependências de produção
RUN npm ci --only=production

# Copiar arquivos buildados do stage anterior
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar arquivos necessários para o servidor
COPY server.js ./

# Criar diretório para confirmações
RUN mkdir -p /app/data

# Copiar configuração customizada do nginx
COPY nginx.conf /etc/nginx/nginx.conf

# Expor porta 80
EXPOSE 80

# Script para iniciar nginx e express
COPY start.sh ./
RUN chmod +x start.sh

CMD ["./start.sh"]
